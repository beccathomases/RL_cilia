\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Phase-plane plots for the top three DQN runs from the tiny reproducible grid, ranked by average reward of the detected best recurrent cycle. These plots help show whether the strongest DQN solutions are genuinely different recurrent motions or only slight variants of one another.}}{3}{}\protected@file@percent }
\newlabel{fig:dqn_top3_phase}{{1}{3}{}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Physical stroke reconstructions for the top three DQN runs. Comparing these stroke plots helps clarify how much geometric variation lies behind the differences in cycle length and average reward.}}{3}{}\protected@file@percent }
