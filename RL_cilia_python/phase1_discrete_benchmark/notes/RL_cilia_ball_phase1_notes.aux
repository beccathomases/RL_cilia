\@writefile{toc}{\contentsline {subsection}{\numberline {1.1}Discrete environment}{1}{subsection.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Phase-space plot of the length-$24$ cycle found by value iteration for the fixed discrete environment with $\gamma =0.99$.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:vi_cycle_phase}{{1}{2}{Phase-space plot of the length-$24$ cycle found by value iteration for the fixed discrete environment with $\gamma =0.99$}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.2}Value iteration}{2}{subsection.1.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Per-step rewards around the value-iteration cycle. Although some portions of the cycle have negative instantaneous reward, the full cycle has positive average reward.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:vi_cycle_rewards}{{2}{3}{Per-step rewards around the value-iteration cycle. Although some portions of the cycle have negative instantaneous reward, the full cycle has positive average reward}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.3}Comparison with tabular Q-learning, PPO, and DQN}{3}{subsection.1.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.4}Comparison figures and value-function diagnostics}{3}{subsection.1.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Tiled phase-plane comparison of the recurrent cycles found by VI, tabular Q-learning, DQN, and PPO. VI, tabular Q-learning, and PPO recover the same length-$24$ cycle up to cyclic phase shift, while DQN converges reproducibly to a nearby but distinct length-$25$ cycle.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:all_methods_phase}{{3}{4}{Tiled phase-plane comparison of the recurrent cycles found by VI, tabular Q-learning, DQN, and PPO. VI, tabular Q-learning, and PPO recover the same length-$24$ cycle up to cyclic phase shift, while DQN converges reproducibly to a nearby but distinct length-$25$ cycle}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Per-step reward traces along the recurrent cycles found by VI, tabular Q-learning, DQN, and PPO. The VI, tabular-Q, and PPO traces agree up to cyclic phase shift, while the DQN trace differs slightly, consistent with its distinct length-$25$ cycle.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:all_methods_rewards}{{4}{5}{Per-step reward traces along the recurrent cycles found by VI, tabular Q-learning, DQN, and PPO. The VI, tabular-Q, and PPO traces agree up to cyclic phase shift, while the DQN trace differs slightly, consistent with its distinct length-$25$ cycle}{figure.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}Discount-factor sweep for value iteration}{5}{section.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Tiled stroke overlays in physical space for the cycles found by VI, tabular Q-learning, DQN, and PPO. The DQN stroke remains geometrically close to the VI/tabular/PPO stroke, but it is not identical.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:all_methods_strokes}{{5}{6}{Tiled stroke overlays in physical space for the cycles found by VI, tabular Q-learning, DQN, and PPO. The DQN stroke remains geometrically close to the VI/tabular/PPO stroke, but it is not identical}{figure.5}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Phase II direction: beyond the exact benchmark}{6}{section.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Heatmap of the optimal value function $V^*$ on the discrete $(\phi _1,\phi _2)$ grid. The smooth gradient structure shows how the optimal policy organizes the state space toward the high-value recurrent stroke.}}{7}{figure.6}\protected@file@percent }
\newlabel{fig:Vstar_heatmap}{{6}{7}{Heatmap of the optimal value function $V^*$ on the discrete $(\phi _1,\phi _2)$ grid. The smooth gradient structure shows how the optimal policy organizes the state space toward the high-value recurrent stroke}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Optimal recurrent cycles in the phase plane for the value-iteration policy at each discount factor \(\gamma \). As \(\gamma \) increases, the optimal cycle becomes longer and moves through a coherent family of larger recurrent orbits.}}{8}{figure.7}\protected@file@percent }
\newlabel{fig:gamma_sweep_phase}{{7}{8}{Optimal recurrent cycles in the phase plane for the value-iteration policy at each discount factor \(\gamma \). As \(\gamma \) increases, the optimal cycle becomes longer and moves through a coherent family of larger recurrent orbits}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Stroke plots in physical space for selected discount factors. These plots show how the phase-plane changes translate into changes in the geometry of the underlying cilia motion.}}{9}{figure.8}\protected@file@percent }
\newlabel{fig:gamma_sweep_strokes}{{8}{9}{Stroke plots in physical space for selected discount factors. These plots show how the phase-plane changes translate into changes in the geometry of the underlying cilia motion}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Length of the optimal recurrent cycle as a function of the discount factor \(\gamma \). The optimal cycle length grows substantially as \(\gamma \) increases.}}{10}{figure.9}\protected@file@percent }
\newlabel{fig:gamma_sweep_length}{{9}{10}{Length of the optimal recurrent cycle as a function of the discount factor \(\gamma \). The optimal cycle length grows substantially as \(\gamma \) increases}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Average reward per cycle as a function of the discount factor \(\gamma \). Larger \(\gamma \) leads to higher-performing recurrent cycles in this environment.}}{10}{figure.10}\protected@file@percent }
\newlabel{fig:gamma_sweep_avgreward}{{10}{10}{Average reward per cycle as a function of the discount factor \(\gamma \). Larger \(\gamma \) leads to higher-performing recurrent cycles in this environment}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Reward traces along the optimal recurrent cycles for each discount factor \(\gamma \). Higher-\(\gamma \) cycles exhibit a different balance of positive and negative rewards, reflecting the greater importance of long-horizon performance in the discounted objective.}}{11}{figure.11}\protected@file@percent }
\newlabel{fig:gamma_sweep_rewards}{{11}{11}{Reward traces along the optimal recurrent cycles for each discount factor \(\gamma \). Higher-\(\gamma \) cycles exhibit a different balance of positive and negative rewards, reflecting the greater importance of long-horizon performance in the discounted objective}{figure.11}{}}
